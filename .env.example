DATABASE_URL=postgres://postgres:postgres@localhost:5432/tackup
# bun run test:db の接続先（省略時は localhost の tackup_test。なければ自動で作成される）
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tackup_test
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ファイルの保存先（Google Cloud Storage）
# ローカルは compose.yaml のエミュレーター（bun run storage:up → bun run storage:setup）
# 本番は STORAGE_API_ENDPOINT と GOOGLE_APPLICATION_CREDENTIALS を設定せず、Cloud Run のサービスアカウントで署名する
STORAGE_BUCKET=tackup
STORAGE_API_ENDPOINT=http://127.0.0.1:4443
GOOGLE_APPLICATION_CREDENTIALS=./.gcs-dev-key.json
